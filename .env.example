# ===== DeepSeek（必需）=====
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 接口地址，一般无需修改；使用第三方 OpenAI 兼容网关时改这里
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== OneBot v11 HTTP API（主动发言用，必需可达）=====
# 宿主机直跑保持默认即可；Docker 部署请务必修改（详见 README「Docker 部署说明」）
#   OneBot 在宿主机（Linux bridge）：  http://172.17.0.1:5700
#   Docker Desktop / host-gateway：    http://host.docker.internal:5700
#   同一 compose 网络：                http://<服务名>:<端口>，如 http://napcat:3000
ONEBOT_API_URL=http://127.0.0.1:5700
# 协议端若设置了 access_token 则填写，否则留空
ONEBOT_ACCESS_TOKEN=

# ===== Serper 联网搜索（可选）=====
# 申请地址：https://serper.dev
SERPER_API_KEY=
